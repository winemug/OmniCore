<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OmniCore.Maui.Models"
             xmlns:pageModels="clr-namespace:OmniCore.Maui.PageModels"
             x:Class="OmniCore.Maui.Pages.RadiosPage"
             x:DataType="pageModels:RadiosPageModel">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding Radios}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BleDeviceModel">
                            <Label Text="{Binding Name}">
                                <Label.GestureRecognizers>
                                    <!-- <TapGestureRecognizer Command="{Binding RequestAndUpdateCommand}"/> -->
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!-- -->
                
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>