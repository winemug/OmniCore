<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OmniCore.Maui.Models"
             xmlns:pageModels="clr-namespace:OmniCore.Maui.PageModels"
             xmlns:services="clr-namespace:OmniCore.Maui.Services"
             x:Class="OmniCore.Maui.Pages.RadiosPage"
             x:DataType="pageModels:RadiosPageModel">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Button Text="Start Scan" Command="{Binding StartScanCommand}"/>
            <ScrollView>
                <CollectionView ItemsSource="{Binding Radios}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:BleDevice">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding FriendlyId}"/>
                                <Label Text="{Binding Name}"/>
                                <Label TextColor="{Binding SignalColor}" Text="{Binding Rssi}"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>