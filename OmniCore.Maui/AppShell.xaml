<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OmniCore.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:OmniCore.Maui.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="OmniCore">

    <ShellContent
        Title="Home"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:HomePage}"
        Route="home" />
    
    <ShellContent
        Title="Radios"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate pages:RadiosPage}"
        Route="radios" />
    
    <ShellContent
        Title="Permissions"
        Icon="{StaticResource IconRibbon}"
        ContentTemplate="{DataTemplate pages:PermissionsPage}"
        Route="permissions" />
    

</Shell>
